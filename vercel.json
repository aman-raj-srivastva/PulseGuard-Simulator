{
  "version": 2,
  "rewrites": [
    {
      "source": "/control",
      "destination": "/api/control"
    },
    {
      "source": "/control/",
      "destination": "/api/control"
    },
    {
      "source": "/api/set-mode",
      "destination": "/api/set-mode"
    },
    {
      "source": "/(.*)",
      "destination": "/api/[...all]"
    }
  ]
}
