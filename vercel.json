{
  "version": 2,
  "redirects": [
    {
      "source": "/control",
      "destination": "/api/control",
      "permanent": false
    },
    {
      "source": "/control/",
      "destination": "/api/control",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/set-mode",
      "destination": "/api/set-mode"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
