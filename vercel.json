{
  "version": 2,
  "rewrites": [
    {
      "source": "/control",
      "destination": "/api/control.js"
    },
    {
      "source": "/control/",
      "destination": "/api/control.js"
    },
    {
      "source": "/api/set-mode",
      "destination": "/api/set-mode.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/[...all].js"
    }
  ]
}
